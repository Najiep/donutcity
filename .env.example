# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=donutcity
DB_PASSWORD=change_this_database_password
DB_NAME=donutcity_portal
# DATABASE_URL=mysql://donutcity:password@127.0.0.1:3306/donutcity_portal

# First startup only. After the first admin exists, changing these does not reset it.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_random_password

# At least 32 random characters. Used to encrypt Discord webhooks at rest.
APP_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# FiveM public endpoint fallback. Do not include /players.json.
FIVEM_SERVER_URL=http://127.0.0.1:30120
FIVEM_POLL_INTERVAL_MS=10000
FIVEM_TIMEOUT_MS=3000
FIVEM_HEARTBEAT_STALE_MS=45000

# Shared by the website backend and dex_webbridge. Use a long random secret.
FIVEM_BRIDGE_SECRET=replace_with_a_long_random_bridge_secret

# Admin session lifetime
SESSION_HOURS=12
